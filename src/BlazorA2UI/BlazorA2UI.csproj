<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>BlazorA2UI</PackageId>
    <Description>Blazor components for A2UI v1.0: renders agent-generated surfaces with native Razor components, a host-controlled media allowlist and class-only styling.</Description>
    <RootNamespace>BlazorA2UI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorA2UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorA2UI.Core\BlazorA2UI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
