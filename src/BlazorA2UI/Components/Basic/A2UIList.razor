@inherits A2UIComponentBase

<div role="list" class="@A2UIClasses.Join("a2ui-list", A2UIClasses.Direction(Raw("direction")) ?? "a2ui-direction-vertical", A2UIClasses.Align(Raw("align")), WeightClass)" @attributes="AccessibilityAttributes()">
    @foreach ((ComponentInstance child, EvaluationContext childContext) in Children("children"))
    {
        <div role="listitem" class="a2ui-list-item">
            <A2UIChild Surface="Surface" Component="child" Context="childContext" Depth="Depth + 1" />
        </div>
    }
</div>

