@using System.Diagnostics.CodeAnalysis
@inject A2UIComponentRegistry Registry
@attribute [UnconditionalSuppressMessage("Trimming", "IL2110", Justification = DynamicComponentJustification)]
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = DynamicComponentJustification)]

@if (Depth > MaxDepth)
{
    <div class="a2ui-placeholder" role="note">Content nested too deeply.</div>
}
else if (Registry.TryGetRenderer(Component, out Type? renderer))
{
    <DynamicComponent Type="renderer" Parameters="Parameters()" />
}
else
{
    <A2UIPlaceholder Surface="Surface" Component="Component" Context="Context" Depth="Depth" />
}

@code {
    /// <summary>
    /// The deepest component rendered; deeper ones render a note. Matches the default tree depth limit.
    /// </summary>
    internal const int MaxDepth = 50;

    /// <summary>
    /// Why the trimmer's warnings about <see cref="DynamicComponent"/> are safe to hide: Blazor sets its annotated
    /// <c>Type</c> parameter by reflection, and every type passed to it comes from the registry, which keeps all
    /// members of each registered renderer.
    /// </summary>
    private const string DynamicComponentJustification = "The renderer type comes from A2UIComponentRegistry, whose Register<TComponent> keeps every member Blazor needs.";

    /// <summary>
    /// Gets or sets the surface the component belongs to.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Surface Surface { get; set; } = null!; // Blazor sets every [EditorRequired] parameter before the first render.

    /// <summary>
    /// Gets or sets the component to render.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public ComponentInstance Component { get; set; } = null!; // Set by Blazor before the first render, like Surface.

    /// <summary>
    /// Gets or sets the data scope of the component.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public EvaluationContext Context { get; set; } = null!; // Set by Blazor before the first render, like Surface.

    /// <summary>
    /// Gets or sets how deep the component is in the rendered tree.
    /// </summary>
    [Parameter]
    public int Depth { get; set; }

    /// <summary>
    /// The parameters passed to the renderer.
    /// </summary>
    private Dictionary<string, object> Parameters() => new(StringComparer.Ordinal)
    {
        [nameof(A2UIComponentBase.Surface)] = Surface,
        [nameof(A2UIComponentBase.Component)] = Component,
        [nameof(A2UIComponentBase.Context)] = Context,
        [nameof(A2UIComponentBase.Depth)] = Depth,
    };
}
