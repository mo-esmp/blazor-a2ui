<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/BlazorA2UI/a2ui.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="s_renderMode" />
</head>

<body>
    <Routes @rendermode="s_renderMode" />
    <script src="@Assets["js/sample.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    /// <summary>
    /// Interactive server rendering without prerendering, so each page connects to the agent once, from its circuit.
    /// </summary>
    private static readonly IComponentRenderMode s_renderMode = new InteractiveServerRenderMode(prerender: false);
}
